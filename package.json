{
	"name": "codevider-website",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"build:production": "NEXT_PUBLIC_SITE_URL=https://www.codevider.com NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL:?NEXT_PUBLIC_BACKEND_URL must be set, e.g. NEXT_PUBLIC_BACKEND_URL=https://api.codevider.com npm run build:production} next build",
		"build:static": "node scripts/build-static.mjs",
		"build-prod": "npm run clean && NEXT_PUBLIC_SITE_URL=https://www.codevider.com npm run build:static && npm run deploy-html-prod && npm run deploy-prod",
		"deploy-html-prod": "s3-deploy './out/**/*.html' --cwd out/ --profile codevider --region us-east-1 --bucket landing-codevier.com --noCache",
		"deploy-prod": "s3-deploy './out/**' --cwd out/ --profile codevider --region us-east-1 --bucket landing-codevier.com",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"clean": "rm -rf .next out"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"dotted-map": "^2.2.3",
		"katex": "^0.18.7",
		"lucide-react": "^1.21.0",
		"mermaid": "^12.0.0",
		"motion": "^12.40.0",
		"next": "16.2.9",
		"ogl": "^1.0.11",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.80.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@next/bundle-analyzer": "^16.2.9",
		"@tailwindcss/postcss": "^4.3.2",
		"@types/katex": "^0.16.8",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@types/react-syntax-highlighter": "^15.5.13",
		"eslint": "^9",
		"eslint-config-next": "16.2.9",
		"tailwindcss": "^4.3.2",
		"typescript": "^5"
	}
}
